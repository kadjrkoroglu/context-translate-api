generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  free
  standard
  premium
}

enum Feature {
  translate
  photo
  chat
  live
}

enum Window {
  hour
  day
  week
  month
}

model User {
  id          Int            @id @default(autoincrement())
  firebaseUid String         @unique @map("firebase_uid")
  tier        Tier           @default(free)
  createdAt   DateTime       @default(now()) @map("created_at")
  usage       UsageCounter[]
  buckets     RateBucket[]

  @@map("users")
}

// Editable limits per tier, feature and time window (no deploy needed to change them)
model PlanLimit {
  tier    Tier
  feature Feature
  window  Window
  limit   Int

  @@id([tier, feature, window])
  @@map("plan_limits")
}

// One row per user, feature and time window; incremented atomically on each request
model UsageCounter {
  userId      Int      @map("user_id")
  feature     Feature
  window      Window
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, feature, window, windowStart])
  @@index([windowStart])
  @@map("usage_counters")
}

// Token bucket settings per tier and feature (capacity + refill speed)
model BucketConfig {
  tier         Tier
  feature      Feature
  capacity     Int
  refillPerSec Float   @map("refill_per_sec")

  @@id([tier, feature])
  @@map("bucket_configs")
}

// Current token bucket state per user and feature
model RateBucket {
  userId    Int      @map("user_id")
  feature   Feature
  tokens    Float
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, feature])
  @@map("rate_buckets")
}

// What each tier may do; null limits mean unlimited
model TierEntitlement {
  tier            Tier    @id
  maxDecks        Int?    @map("max_decks")
  maxCardsPerDeck Int?    @map("max_cards_per_deck")
  photo           Boolean @default(false)
  live            Boolean @default(false)
  chat            Boolean @default(false)

  @@map("tier_entitlements")
}
